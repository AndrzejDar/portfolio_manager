# OpenAI API
# Required for the GPT_api/Chat GPT client project (/api/conversation route).
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Clerk authentication
# Required for sign-in / sign-up flows and user session.
# Get keys at https://dashboard.clerk.com -> your application -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk auth-flow URLs (defaults; override only if you change the routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
